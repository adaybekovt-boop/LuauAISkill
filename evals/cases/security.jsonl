{"id": "SEC-01", "category": "security", "kind": "fixture", "lang": "en", "prompt": "This server script is exploited. Fix it.", "fixture": "evals/fixtures/remote-damage-trust.luau", "must": ["server computes damage from weapon config", "validates target is a character within range/LOS", "rate limit per player", "kill credit on server death event"], "must_not": ["keeps client damage parameter"], "critical": "client-chosen damage", "refs": ["handbook/roblox/04-security.md", "recipes/gameplay/health-damage.md"]}
{"id": "SEC-02", "category": "security", "kind": "fixture", "lang": "en", "prompt": "Coins are being hacked. Fix the design.", "fixture": "evals/fixtures/client-leaderstats.luau", "must": ["coins change only on the server", "server detects coin touch or validates proximity", "client-side leaderstats changes don't replicate but UI lies"], "must_not": ["keeps client increment"], "critical": "client-owned currency", "refs": ["handbook/roblox/04-security.md"]}
{"id": "SEC-03", "category": "security", "kind": "knowledge", "lang": "en", "prompt": "Where can I store an API key for HttpService?", "must": ["HttpService:GetSecret / Secrets store", "never in ReplicatedStorage/client-visible places", "ServerStorage modules are not ideal for secrets"], "must_not": ["ReplicatedStorage config module"], "critical": "leaks secrets", "refs": ["handbook/roblox/04-security.md"]}
{"id": "SEC-04", "category": "security", "kind": "task", "lang": "en", "prompt": "Detect speed hacks without banning legitimate players.", "must": ["server-side displacement sampling", "exemptions (seats, knockback, teleports)", "flag/log, human review; no instant ban"], "must_not": ["kick on first violation"], "critical": "false-positive bans", "refs": ["handbook/roblox/04-security.md", "recipes/gameplay/sprint-crouch-stamina.md"]}
{"id": "SEC-05", "category": "security", "kind": "knowledge", "lang": "en", "prompt": "I inserted a free model and weird scripts appeared. What to look for?", "must": ["require(assetId)", "getfenv/setfenv/loadstring", "obfuscated strings", "remove and audit"], "must_not": ["ignores backdoor risk"], "critical": "misses backdoors", "refs": ["handbook/roblox/04-security.md", "references/debugging-playbook.md"]}
{"id": "SEC-06", "category": "security", "kind": "task", "lang": "en", "prompt": "A remote accepts a nested table from the client (inventory layout). How do you validate depth/size?", "must": ["limit depth and element count", "validate each field type/range", "reject mixed/sparse tables", "prefer flat payloads"], "must_not": ["trusts the structure"], "critical": "unbounded nested payload", "refs": ["handbook/roblox/04-security.md", "handbook/roblox/03-networking.md"]}
{"id": "SEC-07", "category": "security", "kind": "knowledge", "lang": "en", "prompt": "Does `pcall(function() Lighting.Technology = Enum.Technology.Future end)` make it safe to set?", "must": ["Technology is not scriptable/deprecated", "pcall does not grant permission", "use LightingStyle in Studio"], "must_not": ["says pcall solves it"], "critical": "pcall as permission", "refs": ["references/ai-failure-modes.md"]}
{"id": "SEC-08", "category": "security", "kind": "task", "lang": "en", "prompt": "Players can open doors from across the map using an exploit. The door uses a ProximityPrompt. Fix.", "must": ["server-side distance check on Triggered", "optional LOS", "rate limit"], "must_not": ["relies on MaxActivationDistance only"], "critical": "prompt as authority", "refs": ["recipes/gameplay/interaction-system.md"]}
{"id": "SEC-09", "category": "security", "kind": "knowledge", "lang": "en", "prompt": "Can the client see ServerStorage? ServerScriptService? Workspace? ReplicatedStorage?", "must": ["ServerStorage/ServerScriptService: no", "Workspace/ReplicatedStorage: yes (streaming aside)"], "must_not": ["claims ServerStorage is visible"], "critical": "visibility confusion", "refs": ["handbook/roblox/01-runtime-architecture.md"]}
{"id": "SEC-10", "category": "security", "kind": "task", "lang": "en", "prompt": "Design validation for a client-reported melee hit list.", "must": ["attack active window", "reach + latency slack", "cone and LOS", "one hit per target per attack", "alive and not same team"], "must_not": ["accepts hits as-is"], "critical": "client-reported hits accepted", "refs": ["handbook/roblox/15-combat.md"]}
{"id": "SEC-11", "category": "security", "kind": "task", "lang": "en", "prompt": "Add a /give <player> <amount> chat command for admins using TextChatService.", "must": ["TextChatCommand handled in a server Script", "authorize by UserId allowlist or group rank via textSource.UserId, not name", "validate/clamp amount; never echo unfiltered text to others"], "must_not": ["checks admin on the client", "broadcasts the unfiltered message", "legacy Chat service"], "critical": "unauthorized command", "auto": {"forbid": ["\\.Name\\s*==\\s*\"[^\"]+\"\\s*then"], "require_any": ["TextChatCommand"]}, "refs": ["handbook/roblox/26-chat-leaderboards.md"]}
