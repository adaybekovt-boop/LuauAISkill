{"id": "LIT-01", "category": "lighting", "kind": "knowledge", "lang": "en", "prompt": "Set `Lighting.LightingStyle = Enum.LightingStyle.Realistic` from a server script at runtime — will it work?", "must": ["no: Studio/plugin-only write", "set in Studio Properties"], "must_not": ["yes"], "critical": "runtime Studio-only write", "auto": {"forbid": ["LightingStyle\\s*=\\s*Enum"]}, "refs": ["handbook/graphics/01-lighting.md"]}
{"id": "LIT-02", "category": "lighting", "kind": "knowledge", "lang": "en", "prompt": "What's the maximum Range of a PointLight?", "must": ["120 studs"], "must_not": ["60"], "critical": "outdated fact", "auto": {"require_any": ["120"]}, "refs": ["references/limits.md"]}
{"id": "LIT-03", "category": "lighting", "kind": "task", "lang": "en", "prompt": "Light a dark corridor so it feels realistic and tense.", "must": ["pools of light via SpotLights", "very low ambient", "few shadowed lights", "fixture glow, exposure last"], "must_not": ["uniform bright ambient"], "critical": "flat lighting", "refs": ["recipes/graphics/realistic-dark-corridor.md"]}
{"id": "LIT-04", "category": "lighting", "kind": "task", "lang": "en", "prompt": "Each player should get a red low-health vignette/desaturation, only on their screen.", "must": ["effects parented to Camera on the client", "tween in/out, destroy after"], "must_not": ["changes Lighting on the server"], "critical": "global effect for a local state", "refs": ["handbook/graphics/02-atmosphere-sky-post.md"]}
{"id": "LIT-05", "category": "lighting", "kind": "task", "lang": "en", "prompt": "Make a realistic flashlight.", "must": ["SpotLight core + wide spill", "shadows on for own light", "lag/spring", "others see it via replicated state"], "must_not": ["single cone with Brightness 10"], "critical": "flat disc light", "refs": ["recipes/graphics/realistic-flashlight.md"]}
