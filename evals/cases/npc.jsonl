{"id": "NPC-01", "category": "npc", "kind": "task", "lang": "en", "prompt": "A horror monster that patrols, hears sprinting players and chases fairly.", "must": ["FSM with grace period", "noise events not audio", "last known position + search", "one manager, budgets"], "must_not": ["omniscient chase"], "critical": "unfair/omniscient AI", "refs": ["recipes/gameplay/npc-chase.md"]}
{"id": "NPC-02", "category": "npc", "kind": "knowledge", "lang": "en", "prompt": "My NPC stops moving after ~8 seconds walking to a far point. Why?", "must": ["Humanoid:MoveTo times out after ~8 s", "re-issue MoveTo or use waypoints"], "must_not": ["blames network"], "critical": "unaware of MoveTo timeout", "auto": {"require_any": ["8"]}, "refs": ["handbook/roblox/20-npc-ai.md"]}
{"id": "NPC-03", "category": "npc", "kind": "task", "lang": "en", "prompt": "Pathfinding around a door that opens and closes.", "must": ["Path.Blocked replans", "PathfindingModifier/labels or cost", "re-plan throttle"], "must_not": ["recompute every frame"], "critical": "per-frame recompute", "refs": ["handbook/roblox/20-npc-ai.md"]}
{"id": "NPC-04", "category": "npc", "kind": "knowledge", "lang": "en", "prompt": "Should NPC roots be network-owned by the server?", "must": ["SetNetworkOwner(nil) for server-controlled NPCs near players", "prevents flinging and jitter"], "must_not": ["leave auto ownership for combat NPCs"], "critical": "exploitable NPC physics", "refs": ["handbook/roblox/20-npc-ai.md"]}
{"id": "NPC-05", "category": "npc", "kind": "task", "lang": "en", "prompt": "200 ambient townspeople walking around.", "must": ["anchored/CFrame movement or cheap controllers", "client-side animation near camera", "LOD/despawn far", "no Humanoid per NPC unless needed"], "must_not": ["200 Humanoids with scripts"], "critical": "doesn't scale", "refs": ["handbook/roblox/20-npc-ai.md"]}
{"id": "NPC-RU-01", "category": "npc", "kind": "task", "lang": "ru", "prompt": "У NPC путь блокируется после начала движения, а иногда MoveTo не доходит до цели. Нужен ограниченный цикл перепланирования без вечного ожидания.", "must": ["answer in Russian", "handle blocked path and movement timeout", "bounded retry/replan", "cleanup connections", "avoid recomputing path every frame"], "must_not": ["unbounded per-frame pathfinding"], "critical": "unbounded pathfinding work", "refs": ["SKILL.md"]}
