{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Must equal the Worker's name in the Cloudflare dashboard when deploying through Workers Builds.
	"name": "luauaiskill",
	"account_id": "4779193285f4b7225a52cfb160958347",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	// Rebuilds src/generated/data.js from the repository (../api, ../references, Markdown) before every dev/deploy.
	"build": { "command": "node scripts/build-data.mjs", "watch_dir": ["../api", "../handbook", "../recipes", "../references", "../tracks"] },
	// OAuth grants/tokens + site sessions. No id: wrangler provisions the namespace on first deploy.
	"kv_namespaces": [{ "binding": "OAUTH_KV" }],
	// Registered users and subscription status (table created on first use).
	"d1_databases": [{ "binding": "DB", "database_name": "luauaiskill-users" }],
	"ratelimits": [{ "name": "EDGE_RATE_LIMITER", "namespace_id": "47791901", "simple": { "limit": 120, "period": 60 } }],
	"vars": {
		// Public origin users and MCP clients see; OAuth metadata and redirect URIs are built from it.
		"PUBLIC_URL": "https://luaumcp.tklabsskill.site",
		"SITE_URL": "https://luauaiskill-site.pages.dev",
		"AUTH_MODE": "auto",
		"FREE_CALLS_PER_WEEK": "100",
		"CALLS_PER_MINUTE": "60",
		// "registered": any signed-in Google user may use the MCP. "subscribed": an active subscription is required.
		"ACCESS_POLICY": "registered"
	},
	// Secrets (wrangler secret put …): GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, CONSENT_SECRET, optional ADMIN_TOKEN.
	"observability": { "enabled": true },
	"workers_dev": true
}
