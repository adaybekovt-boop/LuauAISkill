{"id": "DBG-01", "category": "debugging", "kind": "knowledge", "lang": "en", "prompt": "RemoteEvent does nothing. Walk me through debugging.", "must": ["check handler side and connection timing", "prints on both sides", "duplicate remote names", "player arg shift"], "must_not": ["random rewrites"], "critical": "no method", "refs": ["references/debugging-playbook.md"]}
{"id": "DBG-02", "category": "debugging", "kind": "knowledge", "lang": "en", "prompt": "Server receives (player, player, data) — why?", "must": ["client passed player to FireServer", "engine adds player automatically"], "must_not": ["adds more parameters"], "critical": "FireServer player arg", "refs": ["references/debugging-playbook.md"]}
{"id": "DBG-03", "category": "debugging", "kind": "knowledge", "lang": "en", "prompt": "Works in Play Solo, breaks in Server & Clients.", "must": ["client/server assumptions, replication, LocalPlayer on server", "test with multiple clients"], "must_not": ["only test in Play"], "critical": "single-client testing", "refs": ["references/debugging-playbook.md"]}
{"id": "DBG-04", "category": "debugging", "kind": "knowledge", "lang": "en", "prompt": "UI resets every time I die.", "must": ["ScreenGui.ResetOnSpawn = true → set false"], "must_not": ["recreate UI"], "critical": "missed ResetOnSpawn", "refs": ["references/debugging-playbook.md"]}
{"id": "DBG-05", "category": "debugging", "kind": "knowledge", "lang": "en", "prompt": "'Infinite yield possible on WaitForChild' — what now?", "must": ["name/path wrong, wrong side, streaming, created later", "timeout + diagnostics"], "must_not": ["wrap in pcall"], "critical": "hides the problem", "refs": ["references/debugging-playbook.md"]}
{"id": "DBG-06", "category": "debugging", "kind": "task", "lang": "en", "prompt": "Z-fighting flicker on floors.", "must": ["coplanar faces; offset/merge"], "must_not": ["change graphics quality"], "critical": "wrong cause", "refs": ["references/debugging-playbook.md"]}
{"id": "DBG-07", "category": "debugging", "kind": "knowledge", "lang": "en", "prompt": "DataStore works in the game but errors in Studio.", "must": ["enable Studio API access", "separate limits", "use a test universe"], "must_not": ["disable DataStores in Studio silently"], "critical": "hides failure", "refs": ["references/debugging-playbook.md"]}
{"id": "DBG-08", "category": "debugging", "kind": "knowledge", "lang": "en", "prompt": "My character jitters/rubber-bands when an ability runs.", "must": ["two writers to CFrame", "server moving a client-owned root", "ownership flipping"], "must_not": ["add more tweens"], "critical": "no ownership reasoning", "refs": ["references/debugging-playbook.md"]}
