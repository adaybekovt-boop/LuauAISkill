--!strict
-- Original reference example. NOT executed in Roblox Studio during pack creation.
-- Host: standalone Luau CLI with filesystem require
-- Assertions for pure modules. Run with a compatible actual Luau binary.
local Finite = require("../pure/FiniteNumbers")
local TokenBucket = require("../pure/TokenBucket")
local Cleanup = require("../pure/Cleanup")
local Generation = require("../pure/Generation")
local Queue = require("../pure/BoundedQueue")
local Result = require("../pure/Result")
local Backoff = require("../pure/Backoff")
local Damp = require("../pure/ExponentialDamp")
local Stats = require("../pure/FrameStats")
local Combat = require("../pure/CombatState")
local Reachability = require("../pure/Reachability")
local tests = 0
local function check(name: string, callback: () -> ())
    callback()
    tests += 1
    print("PASS", name)
end
check("finite boundary", function()
    assert(Finite.is(0) and Finite.is(-12))
    assert(not Finite.is(0 / 0) and not Finite.is(math.huge) and not Finite.is(-math.huge))
    assert(not Finite.is("4") and not Finite.is(false))
    assert(Finite.integer(4, 0, 5) == 4)
    assert(Finite.integer(4.1, 0, 5) == nil)
    assert(Finite.inRange(6, 0, 5) == nil)
end)
check("token capacity and refill", function()
    local b = TokenBucket.new(2, 1, 10)
    assert(b.take(10) and b.take(10) and not b.take(10))
    assert(b.take(11) and not b.take(11))
    assert(not b.take(11, -1) and not b.take(11, 0 / 0))
    assert(b.available(100) == 2)
end)
check("clock rollback cannot create tokens", function()
    local b = TokenBucket.new(1, 1, 10)
    assert(b.take(10))
    assert(not b.take(5))
    assert(not b.take(10))
    assert(b.take(11))
end)
check("cleanup reverse order and idempotence", function()
    local c = Cleanup.new()
    local order: {number} = {}
    c.add(function() table.insert(order, 1) end)
    c.add(function() table.insert(order, 2) end)
    assert(#c.destroy() == 0)
    c.destroy()
    assert(#order == 2 and order[1] == 2 and order[2] == 1)
    c.add(function() table.insert(order, 3) end)
    assert(order[3] == 3 and c.isDestroyed())
end)
check("cleanup errors do not prevent later releases", function()
    local c = Cleanup.new()
    local ran = false
    c.add(function() ran = true end)
    c.add(function() error("expected fixture error") end)
    local errors = c.destroy()
    assert(ran and #errors == 1)
end)
check("generation invalidates old results", function()
    local g = Generation.new()
    local a = g.next()
    assert(g.isCurrent(a))
    local b = g.next()
    assert(not g.isCurrent(a) and g.isCurrent(b))
    g.invalidate()
    assert(not g.isCurrent(b))
end)
check("bounded queue wrap and overflow", function()
    local q: Queue.Queue<number> = Queue.new(2)
    assert(q.push(1) and q.push(2) and not q.push(3))
    assert(q.pop() == 1 and q.push(3))
    assert(q.pop() == 2 and q.pop() == 3 and q.pop() == nil)
    q.clear()
    assert(q.size() == 0)
end)
check("Result false is preserved", function()
    local r = Result.success(false)
    assert(r.ok and r.value == false)
    local e = Result.failure("no")
    assert(not e.ok and e.error == "no")
end)
check("backoff is bounded", function()
    assert(Backoff.delay(1, 1, 10, 1) == 1)
    assert(Backoff.delay(100, 1, 10, 1) == 10)
    assert(Backoff.delay(5, 1, 10, 0) == 0)
end)
check("damping composition", function()
    local one = Damp.step(0, 1, 8, 1 / 30)
    local two = Damp.step(Damp.step(0, 1, 8, 1 / 60), 1, 8, 1 / 60)
    assert(math.abs(one - two) < 1e-10)
end)
check("frame statistics bounded", function()
    local s = Stats.new(3)
    assert(s.snapshot() == nil)
    s.push(0.01); s.push(0.02); s.push(0.03); s.push(0.04)
    local r = s.snapshot()
    assert(r ~= nil and r.count == 3 and r.maxMs == 40)
    assert(math.abs(r.meanMs - 30) < 1e-9)
end)
check("dead character cannot request attack", function()
    local state = Combat.kill(Combat.initial())
    local nextState, allowed = Combat.requestAttack(state, 10)
    assert(not allowed and nextState.phase == "Dead")
end)
check("attack cannot restart during windup", function()
    local state, allowed = Combat.requestAttack(Combat.initial(), 10)
    assert(allowed)
    local same, again = Combat.requestAttack(state, 10.1)
    assert(not again and same.actionId == state.actionId)
end)
check("room reachability detects disconnected node", function()
    local graph = {a = {"b"}, b = {"a"}, c = {}}
    local seen = Reachability.from(graph, "a", 3)
    assert(seen.a and seen.b and not seen.c)
end)
check("zero refill with extreme elapsed cannot produce NaN", function()
    local b = TokenBucket.new(1, 0, -1e308)
    assert(b.take(-1e308))
    assert(not b.take(1e308) and b.available(1e308) == 0)
end)
check("large finite damping remains finite", function()
    local v = Damp.step(-1e308, 1e308, 1, 0)
    assert(v == -1e308)
    local nextValue = Damp.step(-1e308, 1e308, 1, 1)
    assert(nextValue == nextValue and math.abs(nextValue) < math.huge)
end)
print("Completed", tests, "pure Luau test groups")
