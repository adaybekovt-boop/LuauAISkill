{"id": "LIT-07", "category": "lighting", "kind": "knowledge", "lang": "en", "prompt": "I added an Atmosphere and now FogEnd does nothing. Bug?", "must": ["with Atmosphere present legacy fog is ignored", "use Atmosphere Density/Haze"], "must_not": ["reports a bug"], "critical": "unaware of Atmosphere/fog rule", "refs": ["handbook/graphics/02-atmosphere-sky-post.md"]}
{"id": "LIT-08", "category": "lighting", "kind": "task", "lang": "en", "prompt": "A day/night cycle on the server plus client zone moods conflict. How to structure ownership?", "must": ["one owner per property", "server owns ClockTime; clients own zone properties", "don't write same property on both sides"], "must_not": ["both sides tween the same properties"], "critical": "ownership conflict", "refs": ["recipes/graphics/lighting-controller-presets.md"]}
