{
  "name": "LuauAISkill smoke lighting-presets",
  "tree": {
    "$className": "DataModel",
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "StreamingEnabled": false
      },
      "$attributes": {
        "ReleaseSmokeCase": "lighting-presets",
        "ReleaseSmokeEnabled": false,
        "ReleaseSmokeSourceDigest": "SET_USING_CHECK_ENGINE_EVIDENCE_DIGEST",
        "ReleaseSmokeEngineVersion": "",
        "ReleaseSmokeAllowDataStore": false,
        "ReleaseSmokeTestUniverseId": 0,
        "ReleaseSmokeOpenCloud": false,
        "ReleaseSmokePauseForScreenshots": false
      }
    },
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Lib": {
        "$path": "../../lib/ReplicatedStorage/Lib"
      },
      "LightingPresets": {
        "$path": "../../lighting/ReplicatedStorage/LightingPresets.luau"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "ReleaseSmoke": {
        "$path": "../ServerScriptService/ReleaseSmoke"
      },
      "ReleaseSmokeServer": {
        "$path": "../ServerScriptService/ReleaseSmokeServer.server.luau"
      }
    },
    "ServerStorage": {
      "$className": "ServerStorage",
      "SmokeScripts": {
        "$className": "Folder"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "ReleaseSmokeClient": {
          "$path": "../StarterPlayer/StarterPlayerScripts/ReleaseSmokeClient.client.luau"
        },
        "LightingController": {
          "$path": "../../lighting/StarterPlayer/StarterPlayerScripts/LightingController.client.luau"
        }
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "LightingStyle": "Realistic",
        "PrioritizeLightingQuality": true
      }
    }
  }
}
