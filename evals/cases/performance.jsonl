{"id": "PERF-01", "category": "performance", "kind": "fixture", "lang": "en", "prompt": "80 zombies lag the server. Rewrite the architecture.", "fixture": "evals/fixtures/npc-loop-per-npc.luau", "must": ["one manager loop with budget and LOD", "throttled pathfinding, no MoveToFinished:Wait in loop", "task.* not wait", "SetNetworkOwner(nil)"], "must_not": ["keeps one script per zombie"], "critical": "per-NPC loops", "refs": ["recipes/gameplay/npc-patrol.md"]}
{"id": "PERF-02", "category": "performance", "kind": "fixture", "lang": "en", "prompt": "Fix the performance problem.", "fixture": "evals/fixtures/pathfinding-every-frame.luau", "must": ["no ComputeAsync every Heartbeat", "replan on interval/target moved", "direct MoveTo when visible"], "must_not": ["keeps per-frame ComputeAsync"], "critical": "per-frame pathfinding", "refs": ["handbook/roblox/20-npc-ai.md"]}
{"id": "PERF-03", "category": "performance", "kind": "fixture", "lang": "en", "prompt": "Server memory grows until it crashes. Find the leaks.", "fixture": "evals/fixtures/memory-leak.luau", "must": ["Heartbeat connection per character never disconnected", "table keyed by name+tick grows forever", "disconnect on character removal / PlayerRemoving"], "must_not": ["suggests restarting servers"], "critical": "misses connection leak", "refs": ["handbook/roblox/08-performance.md"]}
{"id": "PERF-04", "category": "performance", "kind": "knowledge", "lang": "en", "prompt": "My game runs at 30 FPS on phones. What do you do first?", "must": ["measure: MicroProfiler on device, identify the bound", "one change at a time", "no guesses as facts"], "must_not": ["lists random optimizations with promised FPS gains"], "critical": "invented gains", "refs": ["handbook/roblox/08-performance.md", "recipes/graphics/heavy-scene-performance-pass.md"]}
{"id": "PERF-05", "category": "performance", "kind": "knowledge", "lang": "en", "prompt": "Does adding `--!native` to every script make the game faster?", "must": ["only helps numeric Luau hot paths", "measure", "limits apply", "doesn't speed up engine/rendering"], "must_not": ["yes, always"], "critical": "native everywhere", "refs": ["handbook/luau/06-performance-memory.md"]}
{"id": "PERF-06", "category": "performance", "kind": "task", "lang": "en", "prompt": "A room has 60 PointLights with shadows. FPS drops there. Fix without making it look worse.", "must": ["shadows only on key lights", "fills without shadows, smaller ranges", "emissive fixtures", "measure computeLightingPerform before/after"], "must_not": ["deletes all lights"], "critical": "no measurement", "refs": ["handbook/graphics/03-local-lights.md"]}
{"id": "PERF-07", "category": "performance", "kind": "knowledge", "lang": "en", "prompt": "Is TweenService on the server OK for 50 moving platforms?", "must": ["server tweens replicate every frame, jitter", "tween on clients from replicated state or use physics constraints for gameplay-relevant motion"], "must_not": ["yes"], "critical": "server tween spam", "refs": ["handbook/roblox/08-performance.md", "recipes/gameplay/door-system.md"]}
{"id": "PERF-08", "category": "performance", "kind": "knowledge", "lang": "en", "prompt": "How do you know if GC is causing hitches?", "must": ["MicroProfiler GC scope spikes", "reduce allocations in hot loops", "LuaHeap over time"], "must_not": ["calls collectgarbage('collect')"], "critical": "manual GC calls", "refs": ["handbook/luau/06-performance-memory.md"]}
{"id": "PERF-RU-01", "category": "performance", "kind": "task", "lang": "ru", "prompt": "После добавления 200 NPC появились рывки. Я ещё не делал замеров. Как найти причину и проверить улучшение без обещания конкретного FPS?", "must": ["answer in Russian", "measure before/after in comparable scenario", "profile CPU/render/network separately", "bounded shared scheduling", "no invented metrics"], "must_not": ["promises measured speedup without capture"], "critical": "fabricated performance evidence", "refs": ["SKILL.md"]}
